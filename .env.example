# Clé Gemini pour Lyria RealTime — utilisée UNIQUEMENT en dev (npm run dev).
# Ne jamais publier un build avec une clé : les joueurs saisissent la leur dans le jeu.
VITE_GEMINI_API_KEY=

# TURN gratuit pour le multijoueur (réseaux stricts). Ex. compte gratuit Metered.ca :
# VITE_TURN_URLS=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# ou identifiants récupérés à la volée :
# VITE_METERED_APP=
# VITE_METERED_API_KEY=
